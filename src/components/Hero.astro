---
import Prompt from './Prompt.astro';

const COLUMNS = 24;
---

<section id="about" class="wrap hero">
  <div class="intro">
    <Prompt cmd="whoami" />
    <span class="badge">&lt;/&gt; full stack developer · junior</span>
    <h1>
      Nicolás Sánchez
      <br />
      construyo y <span class="accent">aseguro entornos</span> de principio a fin.
    </h1>
    <p class="lead">
      Desarrollador <span class="hl">Full Stack</span> junior. Técnico superior en{' '}
      <span class="hl">DAM</span> con prácticas como Full-Stack Web Developer: UI, front-end,
      back-end y base de datos. Ahora curso el <span class="hl">máster en ciberseguridad</span> y
      preparo la <span class="hl">OSCP</span>, así que lo que construyo también lo pienso desde el
      lado del atacante.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="#projects">
        $ ls ./projects
      </a>
      <a class="btn btn-ghost" href="#contacto">
        contactar
      </a>
    </div>
  </div>

  <div class="deco" aria-hidden="true">
    <div class="columns" data-hex-columns>
      {Array.from({ length: COLUMNS }, (_, i) => (
        <div class={`col c${i % 12}`} />
      ))}
    </div>
    <div class="radar">
      <div class="ring r1"></div>
      <div class="ring r2"></div>
      <div class="axis v"></div>
      <div class="axis h"></div>
      <div class="sweep"></div>
      <div class="blip b1"></div>
      <div class="blip b2"></div>
      <div class="blip b3"></div>
      <div class="ping"></div>
      <div class="ping late"></div>
      <div class="core"></div>
    </div>
  </div>
</section>

<script>
  // Rellena cada columna con valores hexadecimales aleatorios.
  // El bloque se duplica para que la animación vertical sea un bucle continuo.
  const HEX = '0123456789abcdef';
  const LINES = 44;

  const randomLine = () =>
    Array.from({ length: 4 }, () => HEX[Math.floor(Math.random() * HEX.length)]).join('');

  document.querySelectorAll<HTMLElement>('[data-hex-columns] .col').forEach((col) => {
    const block = Array.from({ length: LINES }, randomLine).join('\n');
    col.textContent = `${block}\n${block}`;
  });
</script>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
    padding-top: 104px;
    padding-bottom: 168px;
  }
  .intro {
    flex: 1 1 480px;
    max-width: 600px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .badge {
    align-self: flex-start;
    font-size: 12px;
    color: var(--accent);
    border: 1px solid rgba(126, 226, 168, 0.35);
    border-radius: 999px;
    padding: 6px 12px;
    background: rgba(126, 226, 168, 0.06);
  }
  h1 {
    margin: 0;
    font-size: 42px;
    line-height: 1.12;
    font-weight: 800;
    color: var(--heading);
    letter-spacing: -0.02em;
  }
  .accent {
    color: var(--accent);
  }
  .lead {
    margin: 0;
    font-size: 18px;
    line-height: 1.75;
    color: var(--muted);
    max-width: 580px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    font-size: 14px;
    border-radius: 8px;
    transition:
      background 0.2s,
      border-color 0.2s;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
  }
  .btn-primary:hover {
    background: var(--accent-hover);
    color: var(--bg);
  }
  .btn-ghost {
    border: 1px solid rgba(126, 226, 168, 0.35);
    color: var(--text);
  }
  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  /* Decorativo: columnas hex + radar, recortado en forma de ojo almendrado */
  .deco {
    --mask:
      radial-gradient(
        ellipse 70% 152% at 50% 160%,
        #000 68%,
        rgba(0, 0, 0, 0.5) 86%,
        transparent 100%
      ),
      radial-gradient(
        ellipse 70% 152% at 50% -60%,
        #000 68%,
        rgba(0, 0, 0, 0.5) 86%,
        transparent 100%
      );
    flex: 1.3 1 600px;
    min-width: 0;
    height: 600px;
    margin-right: min(-24px, calc(576px - 50vw));
    position: relative;
    overflow: hidden;
    -webkit-mask-image: var(--mask);
    -webkit-mask-composite: source-in;
    mask-image: var(--mask);
    mask-composite: intersect;
  }
  .columns {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    gap: 10px;
    font-size: 12px;
    color: rgba(126, 226, 168, 0.34);
  }
  .col {
    white-space: pre;
    line-height: 1.55;
    animation: rain linear infinite;
  }
  .c0 {
    animation-duration: 26s;
  }
  .c1 {
    animation-duration: 34s;
  }
  .c2 {
    animation-duration: 21s;
  }
  .c3 {
    animation-duration: 40s;
  }
  .c4 {
    animation-duration: 29s;
  }
  .c5 {
    animation-duration: 23s;
  }
  .c6 {
    animation-duration: 37s;
  }
  .c7 {
    animation-duration: 31s;
  }
  .c8 {
    animation-duration: 25s;
  }
  .c9 {
    animation-duration: 38s;
  }
  .c10 {
    animation-duration: 22s;
  }
  .c11 {
    animation-duration: 33s;
  }

  .radar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 400px;
    height: 400px;
    margin: -200px 0 0 -200px;
    border-radius: 50%;
    border: 1px solid rgba(126, 226, 168, 0.35);
    background: radial-gradient(circle, rgba(5, 7, 6, 0.75) 60%, rgba(5, 7, 6, 0.35) 100%);
  }
  .ring {
    position: absolute;
    border-radius: 50%;
  }
  .r1 {
    inset: 55px;
    border: 1px solid rgba(126, 226, 168, 0.22);
  }
  .r2 {
    inset: 120px;
    border: 1px solid rgba(126, 226, 168, 0.18);
  }
  .axis {
    position: absolute;
    background: rgba(126, 226, 168, 0.15);
  }
  .axis.v {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
  }
  .axis.h {
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
  }
  .sweep {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      rgba(126, 226, 168, 0.42),
      rgba(126, 226, 168, 0) 70deg,
      transparent 360deg
    );
    animation: sweep 6s linear infinite;
  }
  .blip {
    position: absolute;
    border-radius: 50%;
    animation: flick 2.4s ease-in-out infinite;
  }
  .b1 {
    left: 68%;
    top: 30%;
    width: 8px;
    height: 8px;
    background: var(--accent);
  }
  .b2 {
    left: 28%;
    top: 62%;
    width: 6px;
    height: 6px;
    background: var(--amber);
    animation-delay: 1.1s;
  }
  .b3 {
    left: 55%;
    top: 75%;
    width: 5px;
    height: 5px;
    background: var(--accent);
    animation-delay: 0.6s;
  }
  .ping {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 60px;
    height: 60px;
    margin: -30px 0 0 -30px;
    border-radius: 50%;
    border: 1px solid rgba(126, 226, 168, 0.6);
    animation: ping 3s ease-out infinite;
  }
  .ping.late {
    animation-delay: 1.5s;
  }
  .core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 18px var(--accent);
  }

  @keyframes rain {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-50%);
    }
  }
  @keyframes sweep {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes ping {
    0% {
      transform: scale(0.6);
      opacity: 0.9;
    }
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  @keyframes flick {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 1;
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 40px;
      padding-bottom: 56px;
      gap: 24px;
    }
    h1 {
      font-size: 30px;
    }
    .lead {
      font-size: 15px;
    }
    .deco {
      flex-basis: 100%;
      height: 300px;
      margin-right: 0;
    }
    .radar {
      transform: scale(0.6);
    }
  }
</style>
