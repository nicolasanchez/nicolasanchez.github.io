---
import Prompt from './Prompt.astro';
import { projects } from '../data/site';
---

<section id="projects" class="wrap section">
  <div class="section-head">
    <Prompt cmd="cat ./projects/*" />
    <h2>
      <span class="hl-title">Projects</span>.
    </h2>
    <p>Webs, apps móviles, automatizaciones y paneles.</p>
  </div>
  <div class="grid">
    {projects.map((p) => (
      <article class="card project">
        <div class="bar">
          <span class="dot" />
          <span class="dot" />
          <span class="dot" />
          <span class="file">{p.file}</span>
        </div>
        {p.image ? (
          <img class="shot" src={p.image} alt={`Captura de ${p.first} ${p.rest}`} loading="lazy" />
        ) : (
          <div class="shot placeholder">[ captura del proyecto ]</div>
        )}
        <div class="body">
          <h3>
            {p.url ? (
              <a href={p.url} target="_blank" rel="noopener noreferrer">
                <span class="hl-title">{p.first}</span> {p.rest}
              </a>
            ) : (
              <>
                <span class="hl-title">{p.first}</span> {p.rest}
              </>
            )}
          </h3>
          <p>{p.description}</p>
          <ul class="tags">
            {p.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .hl-title {
    color: var(--accent);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .project {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .bar {
    height: 28px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 12px;
    background: #0d1210;
    border-bottom: 1px solid rgba(126, 226, 168, 0.12);
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3a4440;
  }
  .file {
    font-size: 11px;
    color: var(--dim);
    margin-left: 8px;
  }
  .shot {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: repeating-linear-gradient(135deg, #0b100e 0 10px, #0d1311 10px 20px);
    color: var(--dim);
    font-size: 12px;
  }
  .body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }
  h3 {
    margin: 0;
    font-size: 18px;
    color: var(--heading);
  }
  h3 a {
    color: inherit;
  }
  .body p {
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    font-size: 11px;
    color: var(--fg);
    border: 1px solid rgba(242, 184, 102, 0.35);
    border-radius: 999px;
    padding: 4px 10px;
  }
</style>
