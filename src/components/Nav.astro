---
const links = [
  { href: '/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/writeups/', label: 'Writeups' },
];

const current = Astro.url.pathname;
---

<nav aria-label="Main">
  <a class="brand" href="/">
    nicolás@sec:~$
  </a>
  <ul>
    {links.map(({ href, label }) => (
      <li>
        <a href={href} aria-current={current === href ? 'page' : undefined}>
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    color: var(--fg);
    text-decoration: none;
  }
  a:hover,
  a[aria-current='page'] {
    color: var(--accent);
  }
  .brand {
    font-family: var(--mono);
    font-weight: 700;
    color: var(--accent);
  }
</style>
