---
interface Props {
  cmd?: string;
  cursor?: boolean;
}

const { cmd = '', cursor = false } = Astro.props;
---

<div class="prompt">
  <span class="user">nicolás@sec</span>:<span class="path">~</span>$ {cmd}
  {cursor && <span class="cursor" aria-hidden="true"></span>}
</div>

<style>
  .prompt {
    font-size: 14px;
    color: var(--dim);
  }
  .user {
    color: var(--accent);
  }
  .path {
    color: var(--amber);
  }
</style>
