---
import Icon from './Icon.astro';
import Prompt from './Prompt.astro';
import { contact } from '../data/site';
---

<section id="contacto" class="wrap contact">
  <div class="term">
    <div class="bar">
      <span class="dot red"></span>
      <span class="dot amber"></span>
      <span class="dot green"></span>
      <span class="title">contacto — bash</span>
    </div>
    <div class="body">
      <Prompt cmd="./contactar.sh" />
      <h2 class="sr-only">Contacto</h2>
      <div class="links">
        <a
          class="iconbtn"
          href={contact.linkedin}
          target="_blank"
          rel="me noopener noreferrer"
          aria-label="LinkedIn"
        >
          <Icon name="linkedin" size={26} />
        </a>
        <a
          class="iconbtn"
          href={contact.github}
          target="_blank"
          rel="me noopener noreferrer"
          aria-label="GitHub"
        >
          <Icon name="github" size={26} />
        </a>
        <a class="iconbtn" href={`mailto:${contact.email}`} aria-label="Enviar un email">
          <Icon name="mail" size={26} />
        </a>
      </div>
      <Prompt cursor />
    </div>
  </div>
  <footer>© {new Date().getFullYear()} Nicolás Sánchez Torregrosa · nicosantor.com</footer>
</section>

<style>
  .contact {
    padding-top: 32px;
    padding-bottom: 96px;
  }
  .term {
    border: 1px solid rgba(126, 226, 168, 0.2);
    border-radius: 14px;
    background: #0b0f0d;
    overflow: hidden;
  }
  .bar {
    height: 32px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    border-bottom: 1px solid rgba(126, 226, 168, 0.12);
    background: #0d1210;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .red {
    background: #e0716a;
  }
  .amber {
    background: var(--amber);
  }
  .green {
    background: var(--accent);
  }
  .title {
    font-size: 12px;
    color: var(--dim);
    margin-left: 10px;
  }
  .body {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    padding: 8px 0;
  }
  .iconbtn {
    display: flex;
    width: 60px;
    height: 60px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--accent);
    border-radius: 12px;
    color: var(--accent);
    background: rgba(126, 226, 168, 0.04);
    transition:
      background 0.2s,
      box-shadow 0.2s;
  }
  .iconbtn:hover {
    background: rgba(126, 226, 168, 0.12);
    color: var(--accent-hover);
    box-shadow: 0 0 18px rgba(126, 226, 168, 0.25);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  footer {
    margin-top: 40px;
    text-align: center;
    font-size: 12px;
    color: var(--dim);
  }
  @media (max-width: 760px) {
    .contact {
      padding-bottom: 56px;
    }
    .body {
      padding: 22px;
    }
    .links {
      gap: 20px;
    }
  }
</style>
